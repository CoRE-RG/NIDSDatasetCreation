            <property name="filter" value="type =~ vector AND runattr:experiment =~ demoModification4_visual AND runattr:measurement =~ &quot;$d=0.00004, $packetLen=61, $I=0.00005, $e=0.00001&quot; AND runattr:replication =~ &quot;#0&quot; AND (&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[0]&quot; AND name =~ numTokens:vector) OR&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[1]&quot; AND name =~ numTokens:vector) OR&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[2]&quot; AND name =~ numTokens:vector) OR&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[0]&quot; AND name =~ incomingPacketLengths:vector) OR&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[1]&quot; AND name =~ incomingPacketLengths:vector) OR&#10;    (module =~ &quot;demoModification4.switch2.bridging.streamFilter.ingress.meter[2]&quot; AND name =~ incomingPacketLengths:vector)&#10;)"/>
            <property name="X.Label.Wrap" value="true"/>
            <property name="vector_start_time" value=""/>
            <property name="linestyle" value="solid"/>
            <property name="markersize" value="10"/>
            <property name="drawstyle" value="auto"/>
            <property name="marker" value="none"/>
            <property name="legend_show" value="true"/>
            <property name="simplify" value="false"/>
            <property name="yaxis_max" value="2200"/>
            <property name="Plot.Antialias" value="true"/>
            <property name="xaxis_max" value="0.00044"/>
            <property name="image_export_width" value="6"/>
            <property name="include_fields" value="false"/>
        </chart>
    </charts>
</analysis>
