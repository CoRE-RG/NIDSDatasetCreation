            <property name="plot.properties" value="Line.Color/1 :magenta&#10;Symbols.Type/1 : circle&#10;Symbols.Size/1 : 14&#10;Line.Color/2 : blue&#10;Symbols.Type/2 : diamond&#10;Line.Color/3 : red&#10;Symbols.Type/3 : diamond&#10;Line.Color/4 : orange&#10;Symbols.Type/4 : diamond&#10;Line.Color/5 : blue&#10;Line.Color/6 : red&#10;Line.Style/6 : dashed&#10;Line.Color/7 : orange&#10;Line.Style/7 : dotted"/>
