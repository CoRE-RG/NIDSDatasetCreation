            <property name="legend_manual" value="true"/>
            <property name="yaxis_title" value="Incoming Packet Lengths [b], Num Tokens [b]"/>
            <property name="legend_replacements" value="/incoming packet lengths in/Incoming Frames:/&#10;/number of tokens in/Number of Tokens:/&#10;/demoModification2.switch2.bridging.streamFilter.ingress.meter/ /&#10;/\[0\]/BLUE/&#10;/\[1\]/RED/&#10;/\[2\]/ORANGE/"/>
            <property name="Legend.Border" value="true"/>
