            <property name="plot.properties" value="Line.Color/1 : blue&#10;Symbols.Type/1 : diamond&#10;Line.Color/2 : red&#10;Symbols.Type/2 : diamond&#10;Line.Color/3 : orange&#10;Symbols.Type/3 : diamond&#10;Line.Color/4 : blue&#10;Line.Style/4 : solid&#10;Line.Color/5 : red&#10;Line.Style/5 : dashed&#10;Line.Color/6 : orange&#10;Line.Style/6 : dotted&#10;&#10;&#10;X.Axis.Labels.Show : false&#10;Y.Axis.Labels.Show : false"/>
            <property name="data_export_filename" value=""/>
